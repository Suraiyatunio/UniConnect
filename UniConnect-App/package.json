{
  "name": "uniconnect-desktop",
  "version": "1.0.0",
  "description": "UniConnect – University Management & Student Collaboration Desktop Application",
  "main": "dist-electron/main.js",
  "author": "UniConnect Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:wasm": "node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron/database', {recursive:true}); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'dist-electron/sql-wasm.wasm'); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'dist-electron/database/sql-wasm.wasm');\"",
    "build": "npm run build:vite && npm run build:electron && npm run build:wasm",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "edu.uniconnect.desktop",
    "productName": "UniConnect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniConnect"
    }
  }
}
